# Clinic-edge mode retains its original residency attestation.
MINDCARE_EDGE_RESIDENCY_APPROVED=0
MINDCARE_BOOKING_HOSTING_MODE=clinic
# User-approved Vercel mode: change hosting mode to vercel, approve cloud relay,
# and connect the free Upstash resource (autoUpgrade=false) in production only.
MINDCARE_CLOUD_RELAY_APPROVED=0
# KV_REST_API_URL and KV_REST_API_TOKEN are injected by Vercel Marketplace.
# No clinical DB credentials are configured on the website.
MINDCARE_PUBLIC_ORIGIN=https://booking.example.invalid
# Generate 32 random bytes as hex; same server-only secret on doctor server.
MINDCARE_CLINIC_BRIDGE_SECRET=
# Requires trusted local reverse proxy that replaces x-clinic-client-ip.
MINDCARE_TRUST_EDGE_PROXY=1
MINDCARE_EDGE_BIND=127.0.0.1
MINDCARE_EDGE_TLS_KEY_PATH=
MINDCARE_EDGE_TLS_CERT_PATH=
# No Gemini credential on this website. The doctor's existing environment owns it.
